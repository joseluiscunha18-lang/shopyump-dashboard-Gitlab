# Supabase (shared project with the rest of Shopyump)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Cross-app auth cookie sharing (see architecture doc §5.2).
# Leave unset in local dev; set to ".shopyump.com" in production.
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=

# Public marketplace URL, used for "view store" links from the dashboard
NEXT_PUBLIC_WEB_URL=https://shopyump.com

# OneSignal push (optional — dashboard runs fine without it, push init just no-ops)
NEXT_PUBLIC_ONESIGNAL_APP_ID=
