# Supabase (shared project with the rest of Shopyump)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Cross-app auth cookie sharing (see architecture doc §5.2).
# Leave unset in local dev; set to ".shopyump.com" in production.
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=

# Public marketplace URL, used for "view store" links from the dashboard
NEXT_PUBLIC_WEB_URL=https://shopyump.com

# OneSignal push (optional — dashboard runs fine without it, push init just no-ops)
NEXT_PUBLIC_ONESIGNAL_APP_ID=

# Cloudflare R2 — fotos de produto novas (bucket shopyump-products, https://img.shopyump.com).
# SÓ no servidor (Vercel + .env.local). NUNCA usar o prefixo NEXT_PUBLIC_.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=shopyump-products
R2_PUBLIC_URL=https://img.shopyump.com
# Interruptor: deixar vazio/false até o teste (scripts/r2-smoke-test.mjs) passar; depois true.
R2_UPLOADS_ENABLED=false
