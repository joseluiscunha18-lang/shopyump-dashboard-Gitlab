{
  "rewrites": [
    {
      "source": "/:path((?!_next|api|images|icons|tema-lume|tema-default|manifest|favicon\\.ico).*)",
      "has": [
        {
          "type": "header",
          "key": "x-shop-host",
          "value": "(?!(?:www|app|api|admin|dashboard|painel|mail|email|cdn|static|assets|status|help|ajuda|support|suporte|blog|loja|lojas|temas|login|registar|onboarding)\\.)(?<tenant>[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)\\.shopyump\\.com"
        }
      ],
      "destination": "/loja/:tenant/:path*"
    },
    {
      "source": "/:path((?!_next|api|images|icons|tema-lume|tema-default|manifest|favicon\\.ico).*)",
      "has": [
        {
          "type": "host",
          "value": "(?!(?:www|app|api|admin|dashboard|painel|mail|email|cdn|static|assets|status|help|ajuda|support|suporte|blog|loja|lojas|temas|login|registar|onboarding)\\.)(?<tenant>[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)\\.shopyump\\.com"
        }
      ],
      "destination": "/loja/:tenant/:path*"
    }
  ]
}